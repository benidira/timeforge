# ---- Required for production builds (npm run build fails if missing or placeholder) ----
# Public origin of the site: https, no trailing slash, no path. Used for canonical URLs,
# sitemap, robots and Open Graph. These NEXT_PUBLIC_* values are public by design.
NEXT_PUBLIC_SITE_URL=https://YOUR-DOMAIN.com
# Shown on /contact.
NEXT_PUBLIC_CONTACT_EMAIL=hello@YOUR-DOMAIN.com

# ---- Optional: Google AdSense (nothing is loaded or rendered while empty) ----
# NEXT_PUBLIC_ADSENSE_CLIENT=ca-pub-1234567890123456
# NEXT_PUBLIC_ADSENSE_SLOT_TOOL_TOP=1234567890
# NEXT_PUBLIC_ADSENSE_SLOT_CONTENT_MIDDLE=1234567891
# NEXT_PUBLIC_ADSENSE_SLOT_CONTENT_BOTTOM=1234567892

# ---- Local QA only (never set in production) ----
# ALLOW_PLACEHOLDER_ENV=1
